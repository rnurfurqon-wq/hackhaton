# Salin file ini menjadi .env lalu isi nilainya. File .env TIDAK BOLEH di-push ke GitHub.
ANTHROPIC_API_KEY=isi-dengan-api-key-dari-claude-console
CLAUDE_MODEL_MAIN=claude-sonnet-5-5
CLAUDE_MODEL_FAST=claude-haiku-5-5
# Kode akses supaya link publik tidak menghabiskan saldo API. Kosongkan untuk mematikan.
ACCESS_CODE=
# 1 = mode tiruan tanpa memanggil API (untuk uji tampilan)
MOCK_LLM=0
# Portal karier kampus yang ditautkan di langkah deskripsi posisi (kosongkan untuk menyembunyikan)
CDC_URL=https://cdc.cakrawala.ac.id/login
